{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liveplus-game-relay",
  "main": "cloudflare/game-relay-worker.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVEPLUS_RELAY",
        "class_name": "LivePlusRelayRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LivePlusRelayRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
